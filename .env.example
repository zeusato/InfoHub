# Supabase Configuration
# =====================
# Copy this file to .env.local and replace with your actual Supabase credentials
# Find them at: https://app.supabase.com/project/_/settings/api

# Your Supabase Project URL (format: https://YOUR-PROJECT-ID.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anon/Public Key (safe to use in client-side code)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Base path for Vite
VITE_BASE=/InfoHub/

# Optional: HTTPS URL of the SHOne embed module (no credentials or bypass token).
# Empty uses the SHOne production URL configured in src/lib/shoneEmbed.ts.
VITE_SHONE_EMBED_URL=
